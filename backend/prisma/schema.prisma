generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ProductCategory {
  id       Int               @id @default(autoincrement())
  name     String
  parentId Int?
  products Product[]
  parent   ProductCategory?  @relation("CategoryParent", fields: [parentId], references: [id])
  children ProductCategory[] @relation("CategoryParent")
}

model Product {
  id             Int              @id @default(autoincrement())
  name           String
  sku            String?          @unique
  type           String           @default("service")
  basePrice      Float
  categoryId     Int?
  description    String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  weight         Decimal?         @default(0) @db.Decimal(12, 2)
  bigClientPrice Decimal?         @default(0) @db.Decimal(12, 2)
  serviceOptions Json?            @default("{\"dryWash\": false, \"ironing\": false, \"wetWash\": false, \"externalService\": false}")
  itineraryId    Int?             @map("itinerary_id")
  labelCount     Int              @default(1) @map("label_count") // nº de etiquetas de ropa por unidad (traje 2 piezas = 2)
  printWashLabel Boolean          @default(true) @map("print_wash_label") // si imprime etiquetas de lavado (no para KG ropa blanca, etc.)
  countsForLoad  Boolean          @default(true) @map("counts_for_load") // si computa en la carga de trabajo del día
  workloadWeight Float            @default(1) @map("workload_weight")    // factor de carga (traje=3, camisa=1, kg ropa blanca=0...)
  orderLines     OrderLine[]
  category       ProductCategory? @relation(fields: [categoryId], references: [id])
  variants       ProductVariant[]
  itinerary      Itinerary?       @relation(fields: [itineraryId], references: [id])
}

model ProductVariant {
  id              Int         @id @default(autoincrement())
  productId       Int
  name            String
  attributeValues Json?
  priceModifier   Float       @default(0)
  orderLines      OrderLine[]
  product         Product     @relation(fields: [productId], references: [id])
}

model Order {
  id                    Int             @id @default(autoincrement())
  orderNum              String          @unique
  clientId              Int?
  total                 Float
  paid                  Boolean         @default(false)
  paymentMethod         String?
  observaciones         String?
  fechaLimite           DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  status                String?         @default("pending")
  workerId              Int?
  observacionesInternas String?
  readyReminderAt       DateTime?       @db.Timestamptz(6)
  CashMovement          CashMovement[]
  notification          Notification[]
  payments              Payment[]
  messages              Message[]       @relation("order_messages")
  client                User?           @relation("client_orders", fields: [clientId], references: [id])
  lines                 OrderLine[]
  // Un pedido puede acumular varias facturas: la original, las rectificativas
  // por lo que se quita y las nuevas por lo que se añade. Ver sql/009.
  invoiceTickets        invoiceTickets[]
}

model OrderLine {
  id         Int             @id @default(autoincrement())
  orderId    Int
  productId  Int
  variantId  Int?
  quantity   Int
  unitPrice  Float
  totalPrice Float
  annotations String?         // JSON array: [{"type":"note"|"photo","text?","file?","at","by","origin":"receipt"|"internal"}]
  color       String?          @db.VarChar(30)
  discount    Float?          @default(0)
  // Factura que cubre esta línea; null = pendiente de facturar.
  // FK real en BD (fk_orderline_invoice, ON DELETE SET NULL); se deja como
  // escalar para no obligar a un campo inverso en invoices.
  invoicedInId BigInt?
  // Anulación: las líneas no se borran, para no hacer irreconstruible el
  // ticket que documenta la factura.
  voidedAt     DateTime?      @db.Timestamptz(6)
  voidedBy     Int?
  voidReason   String?
  order      Order           @relation(fields: [orderId], references: [id])
  product    Product         @relation(fields: [productId], references: [id])
  variant    ProductVariant? @relation(fields: [variantId], references: [id])
  steps      OrderLineStep[]

  @@index([invoicedInId])
}

model ServiceStepConfig {
  id           Int             @id @default(autoincrement())
  serviceType  String          @map("service_type") @db.VarChar(30)
  stepKey      String          @map("step_key") @db.VarChar(30)
  stepLabel    String          @map("step_label") @db.VarChar(60)
  position     Int
  durationMin  Int             @default(0) @map("duration_min")
  resourceKey  String?         @map("resource_key") @db.VarChar(30)
  lineSteps    OrderLineStep[]

  @@unique([serviceType, stepKey])
  @@map("service_step_config")
}

model OrderLineStep {
  id              Int                @id @default(autoincrement())
  orderLineId     Int                @map("order_line_id")
  stepConfigId    Int?               @map("step_config_id")
  itineraryStepId Int?               @map("itinerary_step_id")
  status          String             @default("pending") @db.VarChar(15)  // pending, in_progress, done
  startedAt       DateTime?          @map("started_at") @db.Timestamptz(6)
  completedAt     DateTime?          @map("completed_at") @db.Timestamptz(6)
  completedBy     Int?               @map("completed_by")
  orderLine       OrderLine          @relation(fields: [orderLineId], references: [id], onDelete: Cascade)
  stepConfig      ServiceStepConfig? @relation(fields: [stepConfigId], references: [id])
  itineraryStep   ItineraryStep?     @relation(fields: [itineraryStepId], references: [id])
  completedByUser User?              @relation("step_completed_by", fields: [completedBy], references: [id])

  @@unique([orderLineId, stepConfigId])
  @@index([orderLineId])
  @@index([status])
  @@map("order_line_steps")
}

model ResourceConfig {
  id               Int    @id @default(autoincrement())
  resourceKey      String @unique @map("resource_key") @db.VarChar(30)
  label            String @db.VarChar(60)
  units            Int    @default(1)
  processingMode   String @default("individual") @map("processing_mode") @db.VarChar(12) // 'batch' o 'individual'
  batchCapacity    Int    @default(1) @map("batch_capacity")    // Para batch: capacidad por ciclo
  cycleDurationMin Int    @default(0) @map("cycle_duration_min") // batch: min/ciclo, individual: min/prenda
  capacityUnit     String @default("items") @map("capacity_unit") @db.VarChar(15) // 'kg' o 'items'

  @@map("resource_config")
}

model Itinerary {
  id          Int             @id @default(autoincrement())
  name        String          @unique @db.VarChar(80)
  description String?         @db.VarChar(255)
  isActive    Boolean         @default(true) @map("is_active")
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  steps       ItineraryStep[]
  products    Product[]

  @@map("itinerary")
}

model ItineraryStep {
  id           Int             @id @default(autoincrement())
  itineraryId  Int             @map("itinerary_id")
  stepKey      String          @map("step_key") @db.VarChar(30)
  stepLabel    String          @map("step_label") @db.VarChar(60)
  position     Int
  durationMin  Int             @default(0) @map("duration_min")
  resourceKey  String?         @map("resource_key") @db.VarChar(30)
  autoProgress Boolean         @default(false) @map("auto_progress")  // true = "Iniciar/Completar", false = solo "Completar"
  isOptional   Boolean         @default(false) @map("is_optional")   // true = se activa manualmente al crear pedido
  displayOrder Int             @default(0) @map("display_order")     // orden global en el tablero de tracking
  itinerary    Itinerary       @relation(fields: [itineraryId], references: [id], onDelete: Cascade)
  lineSteps    OrderLineStep[]

  @@unique([itineraryId, position])
  @@index([itineraryId])
  @@map("itinerary_step")
}

model WorkSchedule {
  id          Int      @id @default(autoincrement())
  dayOfWeek   Int      @unique @map("day_of_week")  // 0=Dom, 1=Lun ... 6=Sáb
  isWorking   Boolean  @default(true) @map("is_working")
  startTime   String?  @map("start_time") @db.VarChar(5)  // "09:00"
  endTime     String?  @map("end_time")   @db.VarChar(5)  // "20:00"
  capacityMin Int      @default(0) @map("capacity_min")    // Minutos efectivos de trabajo

  @@map("work_schedule")
}

model WorkScheduleException {
  id          Int      @id @default(autoincrement())
  date        DateTime @unique @db.Date
  isWorking   Boolean  @default(false) @map("is_working")
  startTime   String?  @map("start_time") @db.VarChar(5)
  endTime     String?  @map("end_time")   @db.VarChar(5)
  capacityMin Int      @default(0) @map("capacity_min")
  label       String?  @db.VarChar(60)  // "Festivo", "Vacaciones"

  @@map("work_schedule_exceptions")
}

model User {
  id                 Int            @id @default(autoincrement())
  firstName          String
  lastName           String
  email              String?        @unique
  password           String?
  role               String         @default("cashier")
  phone              String?        @unique
  isActive           Boolean        @default(true)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  codigopostal       String?        @db.VarChar
  denominacionsocial String?        @db.VarChar
  direccion          String?        @db.VarChar
  localidad          String?        @db.VarChar
  nif                String?        @db.VarChar
  pais               String?        @db.VarChar
  provincia          String?        @db.VarChar
  tipopersona        String?        @db.VarChar
  isbigclient        Boolean        @default(false)
  autoMonthlyInvoice Boolean        @default(false)
  discount           Float          @default(0)
  notifyChannel      String?        @db.VarChar(10) // 'sms', 'whatsapp', 'none'
  cashClosures       CashClosure[]
  personMovements    CashMovement[] @relation("person_movements")
  cashMovements      CashMovement[] @relation("user_movements")
  orders             Order[]        @relation("client_orders")
  invoices           invoices[]
  clientPayments     Payment[]      @relation("client_payments")
  recorderPayments   Payment[]      @relation("recorder_payments")
  clientMessages     Message[]      @relation("client_messages")
  conversations      Conversation[] @relation("client_conversations")
  completedSteps     OrderLineStep[] @relation("step_completed_by")
  loginLogs          LoginLog[]     @relation("user_login_logs")
}

model LoginLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  email     String?
  success   Boolean  @default(true)
  ip        String?  @db.VarChar(45)
  userAgent String?  @db.VarChar(400)
  reason    String?  @db.VarChar(60)   // motivo del fallo: 'invalid_credentials', 'inactive', 'no_user'
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  user      User?    @relation("user_login_logs", fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
  @@map("login_log")
}

model Notification {
  id              Int           @id @default(autoincrement())
  type            String
  recipient       String
  content         String
  status          String
  sentAt          DateTime      @default(now())
  orderid         Int?
  statusCode      Int?
  subid           String?       @db.VarChar(64)
  statusMessage   String?       @db.VarChar(255)
  conversationId  Int?
  retryCount      Int           @default(0)
  nextRetryAt     DateTime?     @db.Timestamptz(6)
  order           Order?        @relation(fields: [orderid], references: [id], map: "Notification_taskId_fkey")
  conversation    Conversation? @relation(fields: [conversationId], references: [id])
}

model CashClosure {
  id             Int            @id @default(autoincrement())
  openedat       DateTime?      @db.Timestamptz(6)
  closedat       DateTime       @default(now()) @db.Timestamptz(6)
  openingamount  Decimal        @default(0) @db.Decimal(12, 2)
  expectedamount Decimal        @db.Decimal(12, 2)
  countedamount  Decimal        @db.Decimal(12, 2)
  diff           Decimal        @db.Decimal(12, 2)
  userId         Int
  notes          String?
  user           User           @relation(fields: [userId], references: [id])
  movements      CashMovement[]
}

model CashMovement {
  id           Int              @id @default(autoincrement())
  type         CashMovementType
  amount       Decimal          @db.Decimal(12, 2)
  movementat   DateTime         @default(now()) @db.Timestamptz(6)
  orderid      Int?
  userid       Int
  note         String?
  closureId    Int?
  personUserId Int?
  closure      CashClosure?     @relation(fields: [closureId], references: [id])
  order        Order?           @relation(fields: [orderid], references: [id])
  personUser   User?            @relation("person_movements", fields: [personUserId], references: [id])
  user         User             @relation("user_movements", fields: [userid], references: [id])
}

model invoiceLines {
  id          BigInt   @id @default(autoincrement())
  invoiceId   BigInt
  position    Int
  description String
  quantity    Decimal  @default(1) @db.Decimal(12, 3)
  unitPrice   Decimal  @db.Decimal(12, 4)
  discountPct Decimal  @default(0) @db.Decimal(5, 2)
  taxRatePct  Decimal  @db.Decimal(5, 2)
  netAmount   Decimal  @db.Decimal(12, 2)
  taxAmount   Decimal  @db.Decimal(12, 2)
  grossAmount Decimal  @db.Decimal(12, 2)
  invoices    invoices @relation(fields: [invoiceId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model invoiceTickets {
  invoiceId BigInt
  // Sin @unique: un pedido puede estar en varias facturas (sql/009). La clave
  // primaria compuesta sigue impidiendo repetirlo dentro de la misma factura.
  ticketId  Int
  invoices  invoices @relation(fields: [invoiceId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  order     Order    @relation(fields: [ticketId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([invoiceId, ticketId])
  @@index([ticketId], map: "idx_invoiceTickets_ticketId")
}

model invoices {
  id                 BigInt           @id @default(autoincrement())
  number             String?          @db.VarChar
  invoiceYear        Int
  issuedAt           DateTime         @db.Timestamptz(6)
  operationDate      DateTime?        @db.Date
  currency           String           @default("EUR") @db.Char(3)
  sellerName         String
  sellerTaxId        String
  sellerAddress      String
  totalNet           Decimal          @default(0) @db.Decimal(12, 2)
  totalTax           Decimal          @default(0) @db.Decimal(12, 2)
  totalGross         Decimal          @default(0) @db.Decimal(12, 2)
  docStatus          String           @default("draft")
  paymentStatus      String           @default("unpaid")
  isRectifying       Boolean          @default(false)
  rectifiesInvoiceId BigInt?
  notes              String?
  createdAt          DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime         @default(now()) @db.Timestamptz(6)
  clientId           Int?
  paid               Boolean?
  type               String?          @db.Char(1)
  invoiceLines       invoiceLines[]
  invoiceTickets     invoiceTickets[]
  payments           Payment[]
  User               User?            @relation(fields: [clientId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_invoices_client")
  invoices           invoices?        @relation("invoicesToinvoices", fields: [rectifiesInvoiceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  other_invoices     invoices[]       @relation("invoicesToinvoices")
}

model AppSettings {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value String
}

model Conversation {
  id             Int            @id @default(autoincrement())
  clientId       Int?
  phone          String
  lastMessageAt  DateTime       @default(now()) @db.Timestamptz(6)
  unreadCount    Int            @default(0)
  createdAt      DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime       @default(now()) @db.Timestamptz(6)
  client         User?          @relation("client_conversations", fields: [clientId], references: [id])
  messages       Message[]
  notifications  Notification[]

  @@unique([clientId, phone])
}

model Message {
  id              Int           @id @default(autoincrement())
  externalId      String?       @unique
  channel         String        // 'sms', 'whatsapp'
  direction       String        // 'inbound', 'outbound'
  clientId        Int?
  phone           String
  content         String
  mediaUrl        String?
  mediaType       String?       // image, video, audio, document, sticker, location, contact
  templateName    String?
  status          String        @default("pending") // pending, sent, delivered, read, failed
  orderId         Int?
  conversationId  Int?
  retryCount      Int           @default(0)
  nextRetryAt     DateTime?     @db.Timestamptz(6)
  createdAt       DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime      @default(now()) @db.Timestamptz(6)
  client          User?         @relation("client_messages", fields: [clientId], references: [id])
  order           Order?        @relation("order_messages", fields: [orderId], references: [id])
  conversation    Conversation? @relation(fields: [conversationId], references: [id])
}

model Payment {
  id              Int       @id @default(autoincrement())
  amount          Decimal   @db.Decimal(12, 2)
  method          String    // 'cash', 'card_pos', 'stripe', 'transfer'
  status          String    @default("completed") // completed, pending, failed, refunded
  stripePaymentId String?   @unique
  stripeSessionId String?   @unique
  orderId         Int?
  invoiceId       BigInt?
  clientId        Int?
  recordedBy      Int?
  note            String?
  reconciled      Boolean   @default(false)
  reconciledAt    DateTime? @db.Timestamptz(6)
  reconciledBy    Int?
  createdAt       DateTime  @default(now()) @db.Timestamptz(6)
  order           Order?    @relation(fields: [orderId], references: [id])
  invoice         invoices? @relation(fields: [invoiceId], references: [id])
  client          User?     @relation("client_payments", fields: [clientId], references: [id])
  recorder        User?     @relation("recorder_payments", fields: [recordedBy], references: [id])
}

model Campaign {
  id              Int                 @id @default(autoincrement())
  name            String
  templateName    String
  language        String              @default("es")
  status          String              @default("draft") // draft, sending, completed, canceled
  filters         Json?
  totalRecipients Int                 @default(0)
  sentCount       Int                 @default(0)
  failedCount     Int                 @default(0)
  createdBy       Int?
  createdAt       DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime            @default(now()) @updatedAt @db.Timestamptz(6)
  recipients      CampaignRecipient[]

  @@map("campaign")
}

model CampaignRecipient {
  id         Int       @id @default(autoincrement())
  campaignId Int
  clientId   Int?
  phone      String
  firstName  String?
  status     String    @default("pending") // pending, sent, failed
  externalId String?
  error      String?   @db.VarChar(255)
  sentAt     DateTime? @db.Timestamptz(6)
  campaign   Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@map("campaign_recipient")
}

enum CashMovementType {
  sale_cash_in
  withdrawal
  deposit
  refund_cash_out
  opening
  correction
}
